# Never send VCS metadata, environment files, local state or credential material.
.git
**/.git
.env*
**/.env*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/id.json
**/keypair*.json
**/wallet*.json
**/serviceAccount*.json
**/credentials*
**/secrets*
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.sql
**/*.sql.gz
**/*.bak
**/*.dump
**/*.log
.DS_Store
**/.DS_Store

# Repository-only materials that the Dockerfile never copies.
.github
**/.github
patches
sdk
watchtower-site
token-landing
web-shared

# Dependencies, builds, tests and local artifacts.
node_modules
**/node_modules
coverage
**/coverage
build
**/build
dist
**/dist
dist-public
**/dist-public
out
.next
__pycache__
**/__pycache__
data

# The runtime image receives only selected operational JSON and prompt files.
# Exclude all docs/reports/prompts first, then re-include its explicit runtime inputs.
docs/**
!docs/
!docs/ecosystem-target.spec.json
reports/**
!reports/
!reports/*-audit.json
prompts/**
!prompts/
!prompts/arena/
prompts/arena/**
!prompts/arena/
!prompts/arena/max/
prompts/arena/max/**
!prompts/arena/max/
!prompts/studio-os/
prompts/studio-os/**
!prompts/studio-os/
!prompts/arena/PROMPT_ARENA_WATCHTOWER_HUB.md
!prompts/arena/PROMPT_ARENA_ARES1.md
!prompts/arena/PROMPT_ARENA_AOF.md
!prompts/arena/PROMPT_ARENA_NEONRELAY.md
!prompts/arena/PROMPT_ARENA_GUTTERCAPS.md
!prompts/arena/PROMPT_ARENA_TRAFFICGEN.md
!prompts/arena/max/PROMPT_MAX_HUB.md
!prompts/arena/max/PROMPT_MAX_ARES1.md
!prompts/arena/max/PROMPT_MAX_AOF.md
!prompts/arena/max/PROMPT_MAX_NEONRELAY.md
!prompts/arena/max/PROMPT_MAX_GUTTERCAPS.md
!prompts/arena/max/PROMPT_MAX_TRAFFICGEN.md
!prompts/arena/max/PROMPT_MAX_INVESTOR.md
!prompts/studio-os/PROMPT_STUDIO_FINANCE_CONFIG.md

# Do not include repository documentation, test files, or local artifacts.
**/*.md
!docs/ecosystem-target.spec.json
!prompts/arena/PROMPT_ARENA_WATCHTOWER_HUB.md
!prompts/arena/PROMPT_ARENA_ARES1.md
!prompts/arena/PROMPT_ARENA_AOF.md
!prompts/arena/PROMPT_ARENA_NEONRELAY.md
!prompts/arena/PROMPT_ARENA_GUTTERCAPS.md
!prompts/arena/PROMPT_ARENA_TRAFFICGEN.md
!prompts/arena/max/PROMPT_MAX_HUB.md
!prompts/arena/max/PROMPT_MAX_ARES1.md
!prompts/arena/max/PROMPT_MAX_AOF.md
!prompts/arena/max/PROMPT_MAX_NEONRELAY.md
!prompts/arena/max/PROMPT_MAX_GUTTERCAPS.md
!prompts/arena/max/PROMPT_MAX_TRAFFICGEN.md
!prompts/arena/max/PROMPT_MAX_INVESTOR.md
!prompts/studio-os/PROMPT_STUDIO_FINANCE_CONFIG.md
scripts
**/*.test.*
