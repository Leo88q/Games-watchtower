diff --git a/site/factory/landings.py b/site/factory/landings.py
index 39716fb..73bbf91 100644
--- a/site/factory/landings.py
+++ b/site/factory/landings.py
@@ -53,6 +53,24 @@ def targets():
     return {k: v for k, v in parsed.items() if isinstance(k, str) and isinstance(v, str)}
 
 
+def landing_url(site_url, target_value, click_id):
+    """Куда вести после /r/: target_value — «#/route» на своём сайте ИЛИ абсолютный
+    https-адрес игры (из TALKCHART_LANDING_TARGETS). wt_click ставится в query ДО хеша,
+    существующие параметры сохраняются."""
+    from urllib.parse import urlsplit, urlunsplit, urlencode, parse_qsl
+    if target_value.startswith("#") or not target_value:
+        base, fragment = site_url.rstrip("/"), target_value.lstrip("#")
+        parts = urlsplit(base)
+    else:
+        parts = urlsplit(target_value)
+        if parts.scheme not in ("https", "http") or not parts.netloc:
+            raise ValueError(f"цель должна быть https-адресом или #маршрутом: {target_value!r}")
+        fragment = parts.fragment
+    query = [(k, v) for k, v in parse_qsl(parts.query, keep_blank_values=True) if k != "wt_click"]
+    query.append(("wt_click", click_id))
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, urlencode(query), fragment))
+
+
 def valid_click_id(click_id):
     return isinstance(click_id, str) and bool(CLICK_ID_RE.match(click_id))
 
