-            # wt_click — обычным query-параметром ДО хеша: его видит любая страница,
-            # а маршрут SPA остаётся в хеше.
-            location = f"{config.SITE_URL.rstrip('/')}?wt_click={click_id}{allowed[target]}"
+            # #маршрут своего сайта или абсолютный адрес игры; wt_click — в query до хеша
+            try:
+                location = landings.landing_url(config.SITE_URL, allowed[target], click_id)
+            except ValueError as err:
+                return self.send_json(500, error_envelope(str(err), "landing_bad_target", period="live"))
             self.send_response(302)
             self.send_header("Location", location)
             self.send_header("Cache-Control", "no-store")
