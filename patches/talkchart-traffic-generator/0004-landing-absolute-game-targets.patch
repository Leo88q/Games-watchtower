Раньше цель склеивалась с SITE_URL как «#маршрут»: полный адрес игры давал битую ссылку.
landings.landing_url(): #маршрут своего сайта ИЛИ https-адрес игры; wt_click ставится
в query до хеша, существующие параметры сохраняются, чужой wt_click перетирается,
не-http(s) цели отклоняются. Тест + e2e с wt-landing.js из Games-watchtower.
---
 scripts/test_landing_ledger.py      | 12 ++++++++++++
 site/factory/landings.py            | 18 ++++++++++++++++++
 site/factory/watchtower_exporter.py |  8 +++++---
 3 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/scripts/test_landing_ledger.py b/scripts/test_landing_ledger.py
index 1db00e7..71b5fdb 100644
--- a/scripts/test_landing_ledger.py
+++ b/scripts/test_landing_ledger.py
@@ -70,6 +70,18 @@ class TestLedger(unittest.TestCase):
         with self.assertRaises(ValueError):
             cta_href("https://example.site/", "https://evil.example", "click-0003")
 
+    def test_landing_url_site_route_and_absolute_game(self):
+        from landings import landing_url
+        self.assertEqual(landing_url("https://s.example/site", "#/sixsec", "click-0001"),
+                         "https://s.example/site?wt_click=click-0001#/sixsec")
+        self.assertEqual(landing_url("https://s.example", "https://ares1.example/play?ref=x#lobby", "click-0001"),
+                         "https://ares1.example/play?ref=x&wt_click=click-0001#lobby")
+        # чужой wt_click в цели перетирается, а не дублируется
+        self.assertEqual(landing_url("https://s.example", "https://g.example/?wt_click=old", "click-0002"),
+                         "https://g.example/?wt_click=click-0002")
+        with self.assertRaises(ValueError):
+            landing_url("https://s.example", "javascript:alert(1)", "click-0001")
+
