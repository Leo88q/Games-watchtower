# Watchtower OS — ENV example (no secrets, only names)
# Copy to .env and fill real values, never commit .env

# --- Core ---
API_PORT=8787
WATCHTOWER_PROVIDER=mock
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Identity Layer ---
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PHANTOM_APP_ID=
PHANTOM_API_KEY=
FIRSTSTEP_API_KEY=
FIRSTSTEP_PROJECT_ID=
ALTUDE_API_KEY=
ALTUDE_ENDPOINT=https://api.altude.io

# --- Assets cNFT ---
