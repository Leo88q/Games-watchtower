# Watchtower OS — шаблон переменных окружения.
#
# Скопируйте в .env и заполните значения. Файл .env в репозиторий не попадает (.gitignore).
# Раздел 1 читает сервер (server/config.js) — это единственный источник правды по запуску.
# Раздел 2 — переменные внешних интеграций: их читают модули описаний, для запуска хаба они не нужны.
# Секреты в примере пустые: значения подставляет оператор (CI/CD secret store, Vault, Docker secrets).

# ─────────────────────────── 1. ЗАПУСК ХАБА (server/config.js) ───────────────────────────

# Режим: production включает обязательные проверки секретов и отключает демо по умолчанию.
NODE_ENV=production
API_PORT=8787

# Токен приёма событий (write). Без него и без HMAC-секрета сервер не стартует в production.
# Сгенерировать: openssl rand -hex 32
WATCHTOWER_INGEST_TOKEN=
# Альтернатива токену: HMAC-подпись тела запроса (X-Watchtower-Timestamp + X-Watchtower-Signature).
WATCHTOWER_INGEST_HMAC_SECRET=

# Токен чтения. Если задан — все /api/* требуют Authorization: Bearer <токен>.
# Оставьте пустым только для локальной разработки: иначе API открыт всем, кто дотянется до порта.
WATCHTOWER_READ_TOKEN=

# Соль псевдонимизации игроков (≥16 символов). В production обязательна: без неё хеши перебираются по словарю кошельков.
WATCHTOWER_PII_SALT=
# Соль хеширования IP в журнале аудита (необязательна, по умолчанию — случайная на процесс).
WATCHTOWER_IP_HASH_SALT=

# Источник данных и внешние подключения.
WATCHTOWER_PROVIDER=http-ingest
SOLANA_CLUSTER=mainnet-beta
# Если задан — /api/infra/solana выполняет настоящий getHealth по RPC; без него ответ «не проверялось».
SOLANA_RPC_URL=

# Демо-данные: в development включены, в production выключены. Включать только для витрин/скриншотов.
WATCHTOWER_ALLOW_DEMO=0
# Принимать события игр, которых нет в реестре (по умолчанию только ares1, aof, neonrelay, guttercaps, trafficgen).
WATCHTOWER_ALLOW_UNKNOWN_GAMES=0
# Раздавать собранный интерфейс (dist/) с того же порта.
WATCHTOWER_SERVE_STATIC=1
# Каталог собранного бандла. Пусто — ./dist относительно рабочего каталога.
# Задавайте явно, если бандл смонтирован в другое место (в образе это /app/dist).
WATCHTOWER_STATIC_DIR=

# Ограничения и защита.
# XFF принимается только при trust proxy (иначе клиент подделает IP и обойдёт rate limit).
WATCHTOWER_TRUST_PROXY=0
WATCHTOWER_ALLOWED_ORIGINS=
WATCHTOWER_RATE_LIMIT=120
WATCHTOWER_MAX_BODY_BYTES=65536
WATCHTOWER_MAX_EVENTS=250000
WATCHTOWER_EVENT_TTL_HOURS=0
WATCHTOWER_MAX_EVENT_AMOUNT=9007199254740991
WATCHTOWER_MAX_EVENT_AGE_SECONDS=3600
WATCHTOWER_AUDIT_RING=1000
WATCHTOWER_SHUTDOWN_TIMEOUT_MS=10000
WATCHTOWER_LOG_LEVEL=info

# Файлы состояния хаба (единственные записи на диск).
WATCHTOWER_CURSOR_FILE=data/ingestion-cursors.json
WATCHTOWER_SNAPSHOT_FILE=data/investor-snapshots.json

# Факты оператора для экономических метрик. Без них метрики честно возвращают unavailable —
# хаб не выдумывает значения. Цены: актив:цена через запятую.
#
# ПЕРИОД ФИНАНСОВЫХ ФАКТОВ: выручка, расходы и их разбивка (REVENUE_USD, COSTS_USD,
# STABLECOIN_REVENUE_USD, COSMETIC_REVENUE_USD) задаются за КАЛЕНДАРНЫЙ МЕСЯЦ (30 дней)
# и приводятся к выбранному окну пропорционально дням. Такие метрики помечаются
# quality=partial и указывают период в поле source. Остальные факты — на текущую дату:
# CIRCULATING, MAX_SUPPLY, TREASURY_BALANCE, LIQUIDITY_USD, MARKETCAP_USD, SYBIL_FLAGGED.
# Цифры присылает финансовая команда студии: prompts/studio-os/PROMPT_STUDIO_FINANCE_CONFIG.md
WATCHTOWER_ECONOMY_CIRCULATING=
WATCHTOWER_ECONOMY_MAX_SUPPLY=
WATCHTOWER_ECONOMY_TREASURY_BALANCE=
WATCHTOWER_ECONOMY_DAILY_BURN=
WATCHTOWER_ECONOMY_BURN_CADENCE_DAYS=
WATCHTOWER_ECONOMY_REVENUE_USD=
WATCHTOWER_ECONOMY_COSTS_USD=
WATCHTOWER_ECONOMY_STABLECOIN_REVENUE_USD=
WATCHTOWER_ECONOMY_COSMETIC_REVENUE_USD=
WATCHTOWER_ECONOMY_LIQUIDITY_USD=
WATCHTOWER_ECONOMY_MARKETCAP_USD=
WATCHTOWER_ECONOMY_SYBIL_FLAGGED=
WATCHTOWER_ECONOMY_MAIN_ASSET=POTATO
WATCHTOWER_ECONOMY_PRICES=POTATO:0.05,GAME:1

# ─────────────────── 2. ВНЕШНИЕ ИНТЕГРАЦИИ (модули описаний, для хаба не обязательны) ───────────────────
# Эти переменные читают модули server/modules/**: без ключа соответствующий модуль отдаёт configured:false.

# Identity
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PHANTOM_APP_ID=
PHANTOM_API_KEY=
FIRSTSTEP_API_KEY=
FIRSTSTEP_PROJECT_ID=
ALTUDE_API_KEY=
ALTUDE_ENDPOINT=https://api.altude.io

# Indexer / RPC / webhooks
HELIUS_API_KEY=
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream.helius-rpc.com
HELIUS_RPC_URL=wss://atlas-mainnet.helius-rpc.com
HELIUS_WEBHOOK_ID=
WATCHTOWER_WEBHOOK_URL=
SHYFT_API_KEY=
SHYFT_BASE_URL=https://api.shyft.to
SHYFT_MARKET_BASE_URL=https://market.shyft.to
SHYFT_NETWORK=mainnet-beta

# Хранилище и состояние (используются при подключении PG/Redis-индексатора)
DATABASE_URL=
REDIS_URL=

# Аналитика
GAMESIGHT_API_KEY=
GAMESIGHT_ENDPOINT=
GAMESIGHT_PROJECT_ID=
HELIKA_API_KEY=
HELIKA_ENDPOINT=
HELIKA_PROJECT_ID=

# Marketplace / assets
GAMESHIFT_API_KEY=
GAMESHIFT_BASE_URL=
GAMESHIFT_ENV=
MAGIC_EDEN_API_KEY=
MAGIC_EDEN_BASE_URL=https://api-mainnet.magiceden.dev

# L2 / приватность
MAGICBLOCK_API_KEY=
SONIC_API_KEY=
SONIC_GRID_ID=
SONIC_SORADA_ENDPOINT=
REPLA_API_KEY=
REPLA_ENDPOINT=
REPLA_SETTLE_PROGRAM_ID=

# Pull-провайдер трафика (движок trafficgen): база API и токен чтения
TRAFFICGEN_API_BASE_URL=

# ─────────────────────────── 3. ОПЕРАЦИИ, ТЕСТЫ И CI ───────────────────────────
# Адрес API для проверок: smoke-тест и check-ecosystem-target.
WATCHTOWER_API_URL=http://127.0.0.1:8787
# Не поднимать HTTP-слушатель (используется в тестах, требующих только импорт модулей).
WATCHTOWER_NO_LISTEN=
