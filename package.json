{
  "name": "games-watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test:unit": "node --test scripts/economy-metrics.test.mjs scripts/traffic-channels.test.mjs",
    "test:traffic": "node --test scripts/traffic-channels.test.mjs",
    "test:economy": "node --test scripts/economy-metrics.test.mjs",
    "test:hardening": "node --test scripts/api-hardening.test.mjs",
    "test:privacy": "node --test scripts/pii-privacy.test.mjs",
    "test:readonly": "node scripts/check-read-only.mjs",
    "test:docs": "node --test scripts/docs-consistency.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:site": "node --test scripts/site-consistency.test.mjs",
    "site:preview": "node scripts/site-server.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:mutation": "node scripts/mutation-test.mjs --suite=economy && node scripts/mutation-test.mjs --suite=security",
    "test": "npm run test:unit && npm run test:hardening && npm run test:privacy && npm run test:readonly && npm run test:docs && npm run test:ui && npm run test:site",
    "verify": "npm run test && npm run test:mutation && npm run build",
    "release:check": "node scripts/prod-release.mjs",
    "release:plan": "node scripts/prod-release.mjs --dry-run",
    "ecosystem:target": "node scripts/check-ecosystem-target.mjs",
    "ecosystem:target:strict": "node scripts/check-ecosystem-target.mjs --strict"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
