{
  "name": "games-watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "build:public-site": "node scripts/build-public-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test:unit": "node --test scripts/economy-metrics.test.mjs scripts/traffic-channels.test.mjs scripts/live-model.test.mjs scripts/state-durability.test.mjs",
    "test:traffic": "node --test scripts/traffic-channels.test.mjs",
    "test:economy": "node --test scripts/economy-metrics.test.mjs",
    "test:hardening": "node --test --test-concurrency=1 scripts/api-hardening.test.mjs",
    "test:privacy": "node --test scripts/pii-privacy.test.mjs",
    "test:readonly": "node scripts/check-read-only.mjs",
    "test:source-safety": "node scripts/check-source-safety.mjs",
    "test:docs": "node --test scripts/docs-consistency.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:site": "node --test scripts/site-consistency.test.mjs scripts/public-site-build.test.mjs",
    "site:preview": "node scripts/site-server.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "test": "npm run test:unit && npm run test:hardening && npm run test:privacy && npm run test:readonly && npm run test:source-safety && npm run test:agent-safety && npm run test:threat-coverage && npm run test:docs && npm run test:ui && npm run test:site",
    "verify": "npm run test && npm run test:mutation && npm run build && npm run build:public-site",
    "release:check": "node scripts/prod-release.mjs",
    "release:plan": "node scripts/prod-release.mjs --dry-run",
    "ecosystem:target": "node scripts/check-ecosystem-target.mjs",
    "ecosystem:target:strict": "node scripts/check-ecosystem-target.mjs --strict",
    "test:load": "node scripts/load-test.mjs --scenario=read --concurrency=8 --duration=5 --assert",
    "load:full": "node scripts/load-test.mjs --scenario=all --concurrency=16 --duration=10",
    "test:agent-safety": "node --test scripts/agent-safety.test.mjs",
    "test:threat-coverage": "node --test scripts/threat-controls-2026.test.mjs",
    "test:state": "node --test scripts/state-durability.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
